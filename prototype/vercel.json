{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api/gateway?__path=/auth/:path*" },
    { "source": "/api/mcp/:path*", "destination": "/api/gateway?__path=/api/mcp/:path*" },
    { "source": "/api/cart/:path*", "destination": "/api/gateway?__path=/api/cart/:path*" },
    { "source": "/api/history", "destination": "/api/gateway?__path=/api/history" },
    { "source": "/api/tools", "destination": "/api/gateway?__path=/api/tools" },
    { "source": "/api/browse", "destination": "/api/gateway?__path=/api/browse" },
    { "source": "/api/replacements", "destination": "/api/gateway?__path=/api/replacements" },
    { "source": "/api/resolve", "destination": "/api/gateway?__path=/api/resolve" },
    { "source": "/api/walk-map", "destination": "/api/gateway?__path=/api/walk-map" },
    { "source": "/api/auth/:path*", "destination": "/api/gateway?__path=/api/auth/:path*" }
  ],
  "functions": {
    "api/gateway.js": {
      "maxDuration": 60,
      "includeFiles": "content/**"
    }
  },
  "headers": [
    {
      "source": "/auth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
