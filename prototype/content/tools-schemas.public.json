        "feedbackContacts": {
          "description": "Contact preference",
          "type": "string",
          "enum": [
            "call",
            "doNotCall"
          ]
        },
        "isAdultConfirmed": {
          "description": "Confirm adult products",
          "type": "boolean"
        },
        "promoCode": {
          "description": "Promo code to apply",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
