          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shoppingCartId",
        "deliveryType",
        "timeslot",
        "address",
        "shipments"
      ]
    }
